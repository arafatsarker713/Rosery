<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rosery_bg">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Top Header / App Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo in rounded elevation container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/rosery_card_stroke"
                    app:cardBackgroundColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@drawable/rosery_logo"
                        android:contentDescription="Rosery Logo"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- App Branding & Dynamic Greeting -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROSERY"
                        android:textColor="@color/rosery_dark_green"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Farmers and buyers together"
                        android:textColor="@color/rosery_muted"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <!-- Header Actions: Cart Button with Badge & Login Pill -->
                <FrameLayout
                    android:id="@+id/headerCartButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/rosery_card_stroke"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cart"
                            app:tint="@color/rosery_dark_green"
                            android:contentDescription="Cart"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Cart Item Count Badge -->
                    <TextView
                        android:id="@+id/cartBadgeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:minWidth="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_cart_badge"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </FrameLayout>

                <!-- Login / Profile Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.Rosery.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingHorizontal="14dp"
                    android:text="Login"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"/>
            </LinearLayout>

            <!-- Material Search Bar with Clear Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/rosery_card_stroke"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/rosery_green"
                        android:contentDescription="Search"/>

                    <EditText
                        android:id="@+id/searchBox"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search crops, fruits, vegetables..."
                        android:textColor="@color/rosery_text_primary"
                        android:textColorHint="@color/rosery_text_hint"
                        android:textSize="14sp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="10dp"
                        android:paddingEnd="6dp"
                        android:singleLine="true"/>

                    <ImageView
                        android:id="@+id/searchClearButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone"
                        android:contentDescription="Clear search"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hero Promo Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_badge"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/rosery_dark_green"
                            android:contentDescription="Verified"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="100% FARM TRACEABLE"
                            android:textColor="@color/rosery_dark_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Farm to Global Market"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Direct farmer sales • Clear supply journey • Zero middlemen"
                        android:textColor="#E0F2E9"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trackButton"
                        style="@style/Widget.Rosery.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:paddingHorizontal="18dp"
                        android:text="Track Supply Route"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_track"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/rosery_text_primary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Agro Services / Quick Action Cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Agro Services"
                android:textColor="@color/rosery_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- 1. Direct Sales -->
                <LinearLayout
                    android:id="@+id/actionDirectSales"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_action_card_1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:text="🚜"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Direct Sales"
                        android:textAlignment="center"
                        android:textColor="@color/rosery_dark_green"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 2. Supply Track -->
                <LinearLayout
                    android:id="@+id/actionSupplyTracking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_action_card_2"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:text="📦"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tracking"
                        android:textAlignment="center"
                        android:textColor="@color/rosery_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 3. Global Market -->
                <LinearLayout
                    android:id="@+id/actionGlobalMarket"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_action_card_3"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:text="🌍"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Global"
                        android:textAlignment="center"
                        android:textColor="@color/rosery_gold_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 4. Fresh Crops -->
                <LinearLayout
                    android:id="@+id/actionFreshCrops"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_action_card_4"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_circle"
                        android:gravity="center"
                        android:text="🌱"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Fresh Crops"
                        android:textAlignment="center"
                        android:textColor="#6A1B9A"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Agro Categories Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Categories"
                android:textColor="@color/rosery_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Horizontal Scrollable Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <!-- All Produce Chip -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/categoryAll"
                        style="@style/Widget.Rosery.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingHorizontal="16dp"
                        android:text="🌱 All Produce"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"/>

                    <!-- Fresh Crops Chip -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cropsCategory"
                        style="@style/Widget.Rosery.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="🥦 Fresh Crops"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"/>

                    <!-- Direct Sales Chip -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/directSalesCategory"
                        style="@style/Widget.Rosery.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="🚜 Direct Sales"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"/>

                    <!-- Global Market Chip -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/globalMarketCategory"
                        style="@style/Widget.Rosery.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="🌍 Global Market"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"/>

                    <!-- Supply Tracking Chip -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/supplyCategory"
                        style="@style/Widget.Rosery.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="📦 Tracked Supply"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Produce Header with Title and Count Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Featured Produce"
                    android:textColor="@color/rosery_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/productCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:text="8 items"
                    android:textColor="@color/rosery_dark_green"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Empty Search State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_card"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="40sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No Produce Found"
                    android:textColor="@color/rosery_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Try checking for spelling or clear your search."
                    android:textColor="@color/rosery_muted"
                    android:textSize="13sp"
                    android:textAlignment="center"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetFilterButton"
                    style="@style/Widget.Rosery.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="14dp"
                    android:text="View All Produce"
                    android:textSize="12sp"
                    app:cornerRadius="19dp"/>
            </LinearLayout>

            <!-- Produce RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/productsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Modern Elevated Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- 1. Home Tab (Active) -->
        <LinearLayout
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/rosery_green"
                android:contentDescription="Home"/>

            <TextView
                android:id="@+id/homeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/rosery_green"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 2. Supply Tracking Tab -->
        <LinearLayout
            android:id="@+id/navTrackButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/trackIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_track"
                app:tint="@color/rosery_muted"
                android:contentDescription="Tracking"/>

            <TextView
                android:id="@+id/trackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Track"
                android:textColor="@color/rosery_muted"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- 3. Cart Tab with Badge -->
        <FrameLayout
            android:id="@+id/navCartButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/cartNavIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_cart"
                    app:tint="@color/rosery_muted"
                    android:contentDescription="Cart"/>

                <TextView
                    android:id="@+id/cartNavText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cart"
                    android:textColor="@color/rosery_muted"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/navCartBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:minWidth="16dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_cart_badge"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"/>
        </FrameLayout>

        <!-- 4. Orders Tab -->
        <LinearLayout
            android:id="@+id/ordersButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ordersIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_orders"
                app:tint="@color/rosery_muted"
                android:contentDescription="Orders"/>

            <TextView
                android:id="@+id/ordersText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Orders"
                android:textColor="@color/rosery_muted"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- 5. Profile Tab -->
        <LinearLayout
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/rosery_muted"
                android:contentDescription="Profile"/>

            <TextView
                android:id="@+id/profileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/rosery_muted"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
