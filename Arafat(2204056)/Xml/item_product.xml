<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/rosery_card_stroke"
    app:cardBackgroundColor="@color/rosery_surface"
    app:rippleColor="@color/rosery_ripple"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Product Emoji / Icon in soft rounded container -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">

            <TextView
                android:id="@+id/productIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="🌱"
                android:textSize="32sp"/>
        </FrameLayout>

        <!-- Product Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/productName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fresh Tomatoes"
                android:textColor="@color/rosery_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_verified"
                    app:tint="@color/rosery_green"
                    android:contentDescription="Verified"/>

                <TextView
                    android:id="@+id/productOrigin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Local farm • Tracked"
                    android:textColor="@color/rosery_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="৳ 120 / kg"
                android:textColor="@color/rosery_green"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Action Button (Rounded Pill View Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewButton"
            style="@style/Widget.Rosery.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="72dp"
            android:paddingHorizontal="14dp"
            android:text="View"
            android:textSize="13sp"
            app:cornerRadius="19dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
